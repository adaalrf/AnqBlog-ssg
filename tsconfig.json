{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["core/**/*.ts", "modules/**/*.ts", "types/**/*.d.ts", "*.ts"],
  "exclude": [
    "node_modules",
    "public",
    "legacy",
    "dist",
    ".build",
    "client" // Excluded because client files are bundled by Webpack separately
  ]
}
