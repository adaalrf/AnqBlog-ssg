{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "types/**/*.d.ts", "*.ts"],
  "exclude": [
    "node_modules",
    "public",
    "legacy",
    "dist",
    ".build",
    "src/ts" // Excluded because src/ts files are bundled by Webpack separately
    // Note: "src/**/*.ts" in include still matches src/ts, but exclude takes precedence
  ]
}
