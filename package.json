{
  "name": "anq-blog-ssg",
  "version": "0.5.0",
  "description": "A static site generator that converts Markdown to HTML. Supports pagination, tag pages, and CSS processing with Tailwind CSS.",
  "type": "module",
  "scripts": {
    "build": "tsc && node dist/build.js",
    "serve": "tsc && node dist/serve.js",
    "compile": "tsc",
    "test": "tsc && node --test dist/scripts/utils/__tests__/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "keywords": [
    "static-site-generator",
    "ssg",
    "blog",
    "markdown",
    "tailwindcss",
    "static-site",
    "generator"
  ],
  "author": "Adaalrf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adaalrf/anq-blog-ssg.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": "./build.ts",
    "./scripts/*": "./scripts/*.ts"
  },
  "files": [
    "dist",
    "scripts",
    "src",
    "build.ts",
    "serve.ts",
    "webpack.config.js",
    "postcss.config.js",
    "tailwind.config.js",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "gray-matter": "^4.0.3",
    "html-truncate": "^1.2.2",
    "jsdom": "^27.4.0",
    "marked": "^17.0.1",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
