{
  "name": "anq-blog-ssg",
  "version": "0.7.0",
  "private": true,
  "description": "A static site generator that converts Markdown to HTML. Supports pagination, tag pages, and CSS processing with Tailwind CSS.",
  "type": "module",
  "scripts": {
    "build": "tsc --incremental && node dist/core/cli/build.js",
    "serve": "tsc --incremental && node dist/core/cli/serve.js",
    "compile": "tsc",
    "test": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node --test \"dist/core/cli/__tests__/*.test.js\" \"dist/core/internal/__tests__/*.test.js\" \"dist/core/pipeline/__tests__/*.test.js\" \"dist/core/shared/__tests__/*.test.js\" \"dist/modules/**/__tests__/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "static-site-generator",
    "ssg",
    "blog",
    "markdown",
    "tailwindcss",
    "static-site",
    "generator"
  ],
  "author": "Adaalrf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adaalrf/anq-blog-ssg.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "gray-matter": "^4.0.3",
    "html-truncate": "^1.2.2",
    "jsdom": "^27.4.0",
    "marked": "^17.0.1",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
